{
  "uid": "omv-overview",
  "title": "OpenMedVideo Overview",
  "tags": ["openmedvideo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat", "title": "60 s SLO compliance (1h)",
      "description": "Share of jobs whose enqueue-to-outcome time (incl. queue wait and retries) stayed under 60 s.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "omv-prom" },
      "targets": [{ "refId": "A", "expr": "sum(rate(omv_job_total_seconds_bucket{le=\"60.0\"}[1h])) / sum(rate(omv_job_total_seconds_count[1h]))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "noValue": "no jobs in window",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "orange", "value": 0.95 }, { "color": "green", "value": 0.99 } ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "Conversion p95 (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "omv-prom" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(omv_conversion_seconds_bucket[5m])) by (le))" }],
      "fieldConfig": { "defaults": { "unit": "s", "noValue": "idle",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 30 }, { "color": "red", "value": 60 } ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "Jobs pending",
      "description": "Delivered but unacked: in flight or awaiting retry.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "omv-prom" },
      "targets": [{ "refId": "A", "expr": "omv_queue_pending" }],
      "fieldConfig": { "defaults": { "unit": "short",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 } ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "Playback error rate (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "omv-prom" },
      "targets": [{ "refId": "A", "expr": "1 - sum(rate(omv_playback_requests_total{outcome=\"ok\"}[5m])) / sum(rate(omv_playback_requests_total[5m]))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "noValue": "no playback in window",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] } }, "overrides": [] }
    },

    {
      "type": "timeseries", "title": "Job queue",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "omv-prom" },
      "targets": [
        { "refId": "A", "expr": "omv_queue_depth", "legendFormat": "stream depth" },
        { "refId": "B", "expr": "omv_queue_pending", "legendFormat": "pending (in flight / retrying)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Conversion attempts by outcome (per min)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "omv-prom" },
      "targets": [{ "refId": "A", "expr": "sum(rate(omv_conversions_total[5m])) by (outcome) * 60", "legendFormat": "{{outcome}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "success" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "retry" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "dead_letter" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ] }
    },

    {
      "type": "timeseries", "title": "Conversion duration (5m quantiles)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "omv-prom" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(omv_conversion_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(omv_conversion_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Playback requests by outcome (per min)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "omv-prom" },
      "targets": [{ "refId": "A", "expr": "sum(rate(omv_playback_requests_total[5m])) by (outcome) * 60", "legendFormat": "{{outcome}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ok" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "unauthorized" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "not_found" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ] }
    },

    {
      "type": "timeseries", "title": "API requests by route (per min)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "omv-prom" },
      "targets": [{ "refId": "A", "expr": "sum(rate(omv_http_requests_total[5m])) by (route) * 60", "legendFormat": "{{route}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "API error responses (per min)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "omv-prom" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(omv_http_requests_total{status=\"4xx\"}[5m])) * 60", "legendFormat": "4xx" },
        { "refId": "B", "expr": "sum(rate(omv_http_requests_total{status=\"5xx\"}[5m])) * 60", "legendFormat": "5xx" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ] }
    },
    {
      "type": "timeseries", "title": "Webhook deliveries (per min)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "omv-prom" },
      "targets": [{ "refId": "A", "expr": "sum(rate(omv_webhook_deliveries_total[5m])) by (outcome) * 60", "legendFormat": "{{outcome}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "delivered" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "gave_up" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ] }
    }
  ]
}
